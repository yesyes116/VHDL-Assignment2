  <vhdl appearance="logisim_evolution" name="problem4">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity problem4 is&#13;
    port (&#13;
        vote   : in std_logic_vector(24 downto 0);&#13;
        result : out std_logic&#13;
    );&#13;
end problem4;&#13;
&#13;
architecture behavioral of problem4 is&#13;
begin&#13;
    process(vote)&#13;
        variable count : integer range 0 to 25;&#13;
    begin&#13;
        count := 0;&#13;
&#13;
        for i in vote'range loop&#13;
            if vote(i) = '1' then&#13;
                count := count + 1;&#13;
            end if;&#13;
        end loop;&#13;
&#13;
        if count &gt;= 13 then&#13;
            result &lt;= '1';&#13;
        else&#13;
            result &lt;= '0';&#13;
        end if;&#13;
    end process;&#13;
end behavioral;&#13;
