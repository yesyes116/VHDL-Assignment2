  <vhdl appearance="logisim_evolution" name="problem5">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity problem5 is&#13;
    port (&#13;
        vt                  : in std_logic_vector(12 downto 0);&#13;
        en                  : in std_logic;&#13;
        a, b, c, d, e, f, g : out std_logic&#13;
    );&#13;
end problem5;&#13;
&#13;
architecture behavioral of problem5 is&#13;
    signal seg : std_logic_vector(6 downto 0);&#13;
begin&#13;
    process(vt, en)&#13;
        variable count : integer range 0 to 15;&#13;
    begin&#13;
        count := 0;&#13;
&#13;
        for i in vt'range loop&#13;
            if vt(i) = '1' then&#13;
                count := count + 1;&#13;
            end if;&#13;
        end loop;&#13;
&#13;
        if en = '1' then&#13;
            -- Segment order: a b c d e f g&#13;
            case count is&#13;
                when 0  =&gt; seg &lt;= "1111110";&#13;
                when 1  =&gt; seg &lt;= "0110000";&#13;
                when 2  =&gt; seg &lt;= "1101101";&#13;
                when 3  =&gt; seg &lt;= "1111001";&#13;
                when 4  =&gt; seg &lt;= "0110011";&#13;
                when 5  =&gt; seg &lt;= "1011011";&#13;
                when 6  =&gt; seg &lt;= "1011111";&#13;
                when 7  =&gt; seg &lt;= "1110000";&#13;
                when 8  =&gt; seg &lt;= "1111111";&#13;
                when 9  =&gt; seg &lt;= "1111011";&#13;
                when 10 =&gt; seg &lt;= "1110111"; -- A&#13;
                when 11 =&gt; seg &lt;= "0011111"; -- b&#13;
                when 12 =&gt; seg &lt;= "1001110"; -- C&#13;
                when 13 =&gt; seg &lt;= "0111101"; -- d&#13;
                when 14 =&gt; seg &lt;= "1001111"; -- E&#13;
                when 15 =&gt; seg &lt;= "1000111"; -- F&#13;
                when others =&gt; seg &lt;= "0000000";&#13;
            end case;&#13;
        else&#13;
            seg &lt;= "0000000";&#13;
        end if;&#13;
    end process;&#13;
&#13;
    a &lt;= seg(6);&#13;
    b &lt;= seg(5);&#13;
    c &lt;= seg(4);&#13;
    d &lt;= seg(3);&#13;
    e &lt;= seg(2);&#13;
    f &lt;= seg(1);&#13;
    g &lt;= seg(0);&#13;
end behavioral;&#13;
</vhdl>
