  <vhdl appearance="logisim_evolution" name="problem3">library ieee;&#13;
use ieee.std_logic_1164.all;&#13;
&#13;
entity problem3 is&#13;
    port (&#13;
        sel0, sel1, sel2     : in std_logic;&#13;
        a, b, c, d, e, f, g : out std_logic&#13;
    );&#13;
end problem3;&#13;
&#13;
architecture behavioral of problem3 is&#13;
    signal sel : std_logic_vector(2 downto 0);&#13;
    signal seg : std_logic_vector(6 downto 0);&#13;
begin&#13;
    sel &lt;= sel2 &amp; sel1 &amp; sel0;&#13;
&#13;
    -- seg order: a b c d e f g&#13;
    -- '1' turns the corresponding segment on.&#13;
    with sel select&#13;
        seg &lt;= "1111101" when "000", -- a&#13;
               "0011111" when "001", -- b&#13;
               "1001110" when "010", -- C&#13;
               "0111101" when "011", -- d&#13;
               "1000111" when "100", -- F&#13;
               "1111011" when "101", -- g&#13;
               "0000000" when others;&#13;
&#13;
    a &lt;= seg(6);&#13;
    b &lt;= seg(5);&#13;
    c &lt;= seg(4);&#13;
    d &lt;= seg(3);&#13;
    e &lt;= seg(2);&#13;
    f &lt;= seg(1);&#13;
    g &lt;= seg(0);&#13;
end behavioral;&#13;
</vhdl>
